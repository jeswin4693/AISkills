# Copy this file to .env. Never commit .env.

# Which provider to use. Pick one you can get a key for:
#   gemini      Google Gemini (free key with limits). Verified live.
#   openai      OpenAI (paid). Verified live.
#   anthropic   Anthropic (Claude), its own adapter. Not yet verified live: checked against a mock only.
#   groq        Groq (free tier with limits). Verified live on its gpt-oss models; not every Groq model accepts JSON-schema output.
#   openrouter  OpenRouter (some free models). Not yet verified live.
#   mistral     Mistral (free tier). Not yet verified live.
#   custom      Any OpenAI-compatible API: also set LLM_BASE_URL and LLM_API_KEY. Not verified live.
LLM_PROVIDER=gemini

# A model name that your key can use. Models get retired for new users even while they still appear in the
# provider's model list, so pick a current one from the provider's own model page.
LLM_MODEL=

# Fill in only the key for the provider you chose.
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Only for provider "custom":
LLM_BASE_URL=
LLM_API_KEY=

# For provider "anthropic" (and the Step 0 smoke test script):
ANTHROPIC_API_KEY=

# ---- Optional: a different model for a kind of work (docs/ai-engine.md) ---------------------------------------
# Leave all of these out and one model does everything. A tier that is not set uses LLM_PROVIDER and LLM_MODEL.
# Tiers: FAST (reading your words), DESIGN (writing a skill), CODE (writing scripts), ACTOR (running a skill's tests).
# A tier that names another provider also needs that provider's key above, and its own model.
#LLM_CODE_MODEL=
#LLM_ACTOR_PROVIDER=anthropic
#LLM_ACTOR_MODEL=
# Asked once, and only when a skill design still fails its checks after its one repair:
#LLM_ESCALATION_MODEL=

# Limits. Seconds to wait for one answer (default 90; 180 for the CODE tier), and optional caps:
#LLM_TIMEOUT_S=90
#LLM_CODE_TIMEOUT_S=180
#LLM_CODE_MAX_OUTPUT_TOKENS=
#LLM_MAX_INPUT_TOKENS=
# Stop a run after this many attempts at the model (helps a free quota):
#LLM_MAX_CALLS=

# Remember answers so the same request is not paid for twice. Off by default: a repeat then returns the same answer.
#SKILLFORGE_LLM_CACHE=1

# ---- Optional: backup models, so a rate limit or an outage on one provider does not stop you (docs/ai-engine.md) -----
# If the first model is rate limited, out of quota, overloaded or unreachable, these are asked in order. "provider:model",
# separated by commas. Each needs its own key above. Works with any provider listed at the top, free or paid.
# A bad key or a bad request is never passed on: another model would not help, and you should see the mistake.
# Check what is set up, and that every key works, with:  python -m skillforge models --test
#LLM_FALLBACKS=groq:<a model your Groq key can use>,openai:<a model your OpenAI key can use>

# ---- Optional: the hosted (deployed) version (docs/hosting.md). Leave all of these out for local use. ----------------
#SKILLFORGE_MODE=hosted
#SKILLFORGE_ACCESS_TOKEN=      # a long random string, at least 20 characters: the "password" for the web pages
#SKILLFORGE_ALLOWED_HOSTS=     # the host name people open, for example skillforge.example.com
#SKILLFORGE_COOKIE_SECURE=1    # on any https site
#SKILLFORGE_DATA_DIR=/data     # where the library and the database live: keep it on a persistent disk

# ---- Optional: "Sign in with Google", so other people can use your hosted copy (docs/accounts.md). Both or neither. --------
#SKILLFORGE_GOOGLE_CLIENT_ID=  # the PUBLIC Client ID from Google Cloud Console; it ends in .apps.googleusercontent.com. NEVER the client secret: this app does not use it
#SKILLFORGE_ALLOWED_EMAILS=    # who may sign in: addresses, @domain entries, or * for any Google account. Signing in proves who someone is, not that they are welcome
#SKILLFORGE_SHARED_KEY_CALLS_PER_DAY=  # optional, needs the two lines above: model calls a day a signed-in person WITHOUT a key of their own may make on YOUR model (0 or unset: not shared). People can always add their own key under Settings (docs/per-person-keys.md)
# Limits per signed-in person (never the owner). Each is a whole number from 0 to 10000000; 0 means no limit. The defaults are shown (docs/person-limits.md):
#SKILLFORGE_PERSON_DISK_MB=500    # the size of a person's folder (library of every kind) plus their own builds
#SKILLFORGE_PERSON_MAX_BUILDS=50  # builds a person may keep (discarding one makes room)
#SKILLFORGE_PERSON_MAX_ACTIVE=2   # background runs working at once, builds and Testing Lab runs together (the job pool has two workers)
#SKILLFORGE_USAGE_KEEP_DAYS=90    # days of model-call records (counts and timings, never prompts) kept; 0 keeps them for ever; today's are never deleted (docs/database.md)
