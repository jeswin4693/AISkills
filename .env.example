# Copy this file to .env. Never commit .env.

# Which provider to use: openai | anthropic
LLM_PROVIDER=openai

# Model name that your key can use. For OpenAI see https://platform.openai.com/docs/models
LLM_MODEL=

# Provider API keys - fill in only the one you use.
# OpenAI and Anthropic usage is billed to your own account.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
