# Copy this file to .env. Never commit .env.
#
# Default setup is 100% free: local Ollama on your own machine, no account and no key.
#   1. Install Ollama from https://ollama.com
#   2. Run: ollama pull qwen2.5:7b
#   3. Leave the values below as they are.

# Which provider to use: ollama | anthropic
LLM_PROVIDER=ollama

# Model name. For local Ollama this must be a model you have pulled.
LLM_MODEL=qwen2.5:7b

# Ollama. Local needs no key. For Ollama Cloud use https://ollama.com/v1 and set a key.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=

# Optional paid or hosted providers - fill in only if you use them
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
