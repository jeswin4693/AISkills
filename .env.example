# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider adapter to use: ollama | anthropic (openai | gemini later)
LLM_PROVIDER=

# Model name for the chosen provider (set once you pick one)
LLM_MODEL=

# Ollama Cloud (OpenAI-compatible endpoint). For a local Ollama use http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

# Other provider API keys - fill in only the one(s) you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
