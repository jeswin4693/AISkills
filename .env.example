# Copy this file to .env. Never commit .env.

# Which provider to use: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Model name that your key can use. Models get retired for new users even while they still appear in
# the provider's model list, so pick a current one (for Gemini, see https://ai.google.dev/gemini-api/docs/models).
LLM_MODEL=

# Provider API keys - fill in only the one you use.
# Gemini: a free key from https://aistudio.google.com/apikey (free tier has rate limits).
# OpenAI and Anthropic usage is billed to your own account.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
