# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider adapter to use: anthropic | openai | gemini | ollama
LLM_PROVIDER=

# Model name for the chosen provider (set once you pick one)
LLM_MODEL=

# Provider API keys - fill in only the one(s) you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local model endpoint (future Ollama support)
OLLAMA_BASE_URL=http://localhost:11434
